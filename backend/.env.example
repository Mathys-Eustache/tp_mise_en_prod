# Modèle de configuration : copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env contient des secrets : il n'est jamais commité (voir .gitignore).

# URL du Session pooler Supabase (Connect > Direct > Session pooler), mot de passe compris
DATABASE_URL=postgresql://postgres.<ref-du-projet>:<mot-de-passe>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Port local de l'API (Scalingo fournit le sien automatiquement)
PORT=3000

# Origines autorisées à appeler l'API, séparées par des virgules.
# Vide en local = tout autorisé. En production : l'URL Vercel, sans / final.
CORS_ORIGIN=
